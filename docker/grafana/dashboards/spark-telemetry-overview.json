{
  "annotations": {"list": []},
  "description": "Application-level Spark telemetry correlated across plugin metrics, logs, traces, and profiles. The service dashboard opens the exact application runtime with five seconds of padding on each side.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "apps",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": false,
      "title": "Service applications",
      "tooltip": "Return to the application run list for this service",
      "type": "link",
      "url": "/d/spark-service-executor-memory-preview/spark-service-applications?var-service=$service&from=now-7d&to=now"
    }
  ],
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": [], "title": "Application overview · local-$application", "type": "row"},
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "description": "End-to-end duration of the selected Spark application root trace.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
      "targets": [{"datasource": {"type": "tempo", "uid": "tempo"}, "filters": [], "limit": 1, "query": "{ resource.service.name =~ \"$service\" && resource.spark.app.id = \"local-$application\" && name = \"spark.application\" }", "queryType": "traceql", "refId": "A", "tableType": "traces"}],
      "title": "Application duration", "transformations": [{"id": "filterFieldsByName", "options": {"include": {"names": ["traceDuration"]}}}], "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "description": "Total Spark jobs created by this application.",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=\"local_${application}_driver_DAGScheduler_job_allJobs_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Jobs", "range": false, "refId": "A"}],
      "title": "Jobs", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Total input bytes read by completed tasks.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=\"local_${application}_driver_executor_bytesRead_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Input", "range": false, "refId": "A"}],
      "title": "Input read", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}}, "overrides": []},
      "description": "Tasks completed successfully in the selected application.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=\"local_${application}_driver_executor_succeededTasks_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Completed tasks", "range": false, "refId": "A"}],
      "title": "Completed tasks", "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "description": "Error or fatal logs emitted by the selected application driver.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1}, "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "sum(count_over_time({service_name=~\"$service\",service_instance_id=\"local-$application/driver\"} | detected_level=~\"error|fatal\" [$__range])) or vector(0)", "legendFormat": "Errors", "queryType": "instant", "refId": "A"}],
      "title": "Error logs", "type": "stat"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "description": "Failed task attempts counted from retained ERROR task spans. Spark ExecutorSource does not expose an executor.failedTasks metric.",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1}, "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
      "targets": [{"datasource": {"type": "tempo", "uid": "tempo"}, "limit": 20, "metricsQueryType": "instant", "query": "{ resource.service.name =~ \"$service\" && resource.spark.app.id = \"local-$application\" && name = \"spark.task\" && status = error } | count_over_time()", "queryType": "traceql", "refId": "A", "tableType": "metrics"}],
      "title": "Failed task attempts", "type": "stat"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 102, "panels": [], "title": "Executor / driver memory overview", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Top Spark JVMs by sampled maximum heap in the selected time range, grouped by the native spark.executor.id metric resource attribute. Click a bar to open that executor or local-mode driver in the repeated memory row. Applications ending before the first ExecutorMetrics heartbeat can remain at zero.",
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-YlRd"}, "links": [{"targetBlank": false, "title": "Open ${__field.labels.spark_executor_id}", "url": "/d/spark-telemetry-executor-memory-preview/spark-application-detail?${service:queryparam}&${application:queryparam}&var-executor=${__field.labels.spark_executor_id}&var-traceId=$traceId&from=${__from}&to=${__to}"}], "mappings": [], "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 6}, "id": 9,
      "options": {"displayMode": "gradient", "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "sizing": "auto", "text": {}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "topk(10, max by (spark_executor_id) (max_over_time({__name__=~\"local_${application}_.+_ExecutorMetrics_JVMHeapMemory_ratio\",job=~\"$service\",spark_executor_id=~\".+\"}[$__range])))", "instant": true, "legendFormat": "{{spark_executor_id}}", "range": false, "refId": "A"}],
      "title": "Spark JVMs · sampled max heap", "type": "bargauge"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}, "id": 104, "panels": [], "repeat": "executor", "title": "Memory · $executor", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Executor-local JVM memory pools. Process RSS is an optional Linux process-tree ceiling and is not summed with the JVM pools.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "stepAfter", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "auto", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "bytes"}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]}, {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]}, {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}, {"matcher": {"id": "byFrameRefID", "options": "D"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]}, {"matcher": {"id": "byFrameRefID", "options": "E"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}, {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}]}]},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "id": 13,
      "interval": "1s",
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_JVMHeapMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "JVM heap", "range": true, "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_JVMOffHeapMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "JVM non-heap", "range": true, "refId": "B"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_DirectPoolMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "Direct pool", "range": true, "refId": "C"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_MappedPoolMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "Mapped pool", "range": true, "refId": "D"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_ProcessTreeJVMRSSMemory_ratio\",job=~\"$service\"}[$__interval])) > 0", "legendFormat": "Process RSS", "range": true, "refId": "E"}],
      "title": "JVM & process footprint · $executor", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Executor-local Spark execution and storage memory. Unified metrics are omitted because they duplicate these four components.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 28, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "stepAfter", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "auto", "spanNulls": false, "stacking": {"group": "A", "mode": "normal"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "id": 14,
      "interval": "1s",
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_OnHeapExecutionMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "on-heap execution", "range": true, "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_OnHeapStorageMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "on-heap storage", "range": true, "refId": "B"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_OffHeapExecutionMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "off-heap execution", "range": true, "refId": "C"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_OffHeapStorageMemory_ratio\",job=~\"$service\"}[$__interval]))", "legendFormat": "off-heap storage", "range": true, "refId": "D"}],
      "title": "Spark managed memory · $executor", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Maximum executor-local values observed in the selected dashboard time range.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "bytes"}, "overrides": []},
