      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_JVMHeapMemory_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Peak JVM heap", "range": false, "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_ProcessTreeJVMRSSMemory_ratio\",job=~\"$service\"}[$__range])) > 0", "instant": true, "legendFormat": "Peak process RSS", "range": false, "refId": "B"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_DirectPoolMemory_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Peak direct pool", "range": false, "refId": "C"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_MappedPoolMemory_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Peak mapped pool", "range": false, "refId": "D"}, {"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(max_over_time({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_OnHeapStorageMemory_ratio\",job=~\"$service\"}[$__range]))", "instant": true, "legendFormat": "Peak on-heap storage", "range": false, "refId": "E"}],
      "title": "Selected-range peaks · $executor", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "GC collection-time rate derived from the cumulative ExecutorMetrics TotalGCTime gauge. This is a pressure proxy, not exact stop-the-world time, and can exceed 100% for overlapping collectors. The 10% line is a diagnostic reference.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "stepAfter", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "line"}}, "decimals": 1, "mappings": [], "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 22}, "id": 16,
      "interval": "1s",
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "editorMode": "code", "expr": "max(clamp_min(rate({__name__=~\"local_${application}_${executor:regex}_ExecutorMetrics_TotalGCTime_ratio\",job=~\"$service\"}[$__rate_interval]), 0)) / 10", "legendFormat": "GC time", "range": true, "refId": "A"}],
      "title": "GC pressure · $executor", "type": "timeseries"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 29}, "id": 103, "panels": [], "title": "Diagnostics · traces & logs", "type": "row"},
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "description": "Retained task attempts that failed or exceeded the plugin's configured slow-task threshold. Failed rows expose a structured error type and summary; open the trace to inspect the standard exception event and stack trace.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true, "inspect": false}}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 30}, "id": 17,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "Started"}]},
      "targets": [{"datasource": {"type": "tempo", "uid": "tempo"}, "limit": 100, "metricsQueryType": "range", "query": "{ resource.service.name =~ \"$service\" && resource.spark.app.id = \"local-$application\" && name = \"spark.task\" && (status = error || span.spark.telemetry.task.slow = true) } | select(span.error.type, span.spark.task.failure.type, span.spark.task.failure.message, span.spark.task.partition, span.spark.task.attempt-number, span.spark.telemetry.task.slow, span.outcome)", "queryType": "traceql", "refId": "A", "tableType": "spans"}],
      "title": "Failed & slow task attempts",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"name": true, "traceName": true, "traceService": true}, "includeByName": {}, "indexByName": {"Span ID": 0, "Start time": 1, "outcome": 2, "status": 3, "error.type": 4, "spark.task.failure.type": 5, "spark.task.failure.message": 6, "spark.task.partition": 7, "spark.task.attempt-number": 8, "spark.telemetry.task.slow": 9}, "renameByName": {"Span ID": "Task trace", "Start time": "Started", "error.type": "Error type", "outcome": "Outcome", "spark.task.attempt-number": "Attempt", "spark.task.failure.message": "Failure", "spark.task.failure.type": "Spark reason", "spark.task.partition": "Partition", "spark.telemetry.task.slow": "Slow", "status": "Status"}}}],
