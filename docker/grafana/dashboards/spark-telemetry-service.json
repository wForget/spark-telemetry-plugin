        "orientation": "auto",
        "reduceOptions": {"calcs": ["max"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "filters": [],
          "limit": 1000,
          "query": "{ resource.service.name =~ \"$service\" && name = \"spark.application\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
