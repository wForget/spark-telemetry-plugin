    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "id": 101,
      "panels": [],
      "title": "Application runs · click Started to open details",
      "type": "row"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "description": "One row per Spark application root span. The Started link opens the application dashboard with the selected service, application ID, and a 10-second window centered on the root span start.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "application"},
            "properties": [
              {"id": "displayName", "value": "Run ID"},
              {"id": "custom.width", "value": 260}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "time"},
            "properties": [
              {"id": "displayName", "value": "Started"},
              {"id": "unit", "value": "dateTimeAsIso"},
              {"id": "custom.width", "value": 220},
              {"id": "custom.cellOptions", "value": {"type": "data-links"}},
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open application local-${__data.fields.application:raw}",
                    "url": "/d/spark-telemetry-overview/spark-application-detail?var-service=${__data.fields[\"service.name\"]:raw}&var-application=${__data.fields.application:raw}&var-executor=driver&var-traceId=${__data.fields.traceIdHidden:raw}&from=${__value.raw}&to=now"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "duration"},
            "properties": [
              {"id": "displayName", "value": "Duration"},
              {"id": "unit", "value": "ns"},
              {"id": "custom.width", "value": 150}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "traceIdHidden"},
            "properties": [
              {"id": "displayName", "value": "Trace ID"},
              {"id": "custom.width", "value": 300}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "service.name"},
            "properties": [{"id": "displayName", "value": "Service"}]
          }
        ]
      },
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 7},
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Started"}]
      },
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "filters": [],
          "limit": 1000,
          "query": "{ resource.service.name =~ \"$service\" && name = \"spark.application\" } | select(resource.spark.app.id, resource.spark.app.name)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Application runs",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "regexp",
            "keepTime": false,
            "regExp": "/^local-(?<application>[0-9]+)$/",
            "replace": false,
            "source": "spark.app.id"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "name": true,
              "spanID": true,
              "spark.app.id": true,
              "spark.app.name": true,
              "traceName": true,
              "traceService": true
            },
            "includeByName": {},
            "indexByName": {
              "service.name": 0,
              "application": 1,
              "time": 2,
              "traceIdHidden": 3,
              "duration": 4
            },
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["spark", "service", "applications", "opentelemetry", "telemetry"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": {"text": "telemetry-plugin-signals-smoke", "value": "telemetry-plugin-signals-smoke"},
        "datasource": {"type": "prometheus", "uid": "mimir"},
        "definition": "label_values(target_info, job)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {"query": "label_values(target_info, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-7d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Spark Service Applications",
  "uid": "spark-telemetry-service",
  "version": 1
}
