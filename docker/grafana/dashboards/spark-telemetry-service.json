      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "filters": [],
          "limit": 1000,
          "query": "{ resource.service.name =~ \"$service\" && name = \"spark.application\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Latest run",
      "transformations": [
        {"id": "filterFieldsByName", "options": {"include": {"names": ["startTime"]}}},
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [{"destinationType": "number", "targetField": "startTime"}],
            "fields": {}
          }
        },
        {"id": "reduce", "options": {"includeTimeField": false, "mode": "reduceFields", "reducers": ["max"]}}
      ],
      "type": "stat"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "description": "Mean end-to-end duration of application root traces in this service window.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
